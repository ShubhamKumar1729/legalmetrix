# ---------------------------------------------------------------------------
# LegalMetrix — environment configuration
# Copy to .env and fill in real values. Never commit the .env file.
# ---------------------------------------------------------------------------

# Database -----------------------------------------------------------------
# Leave empty to run on the in-memory store (development only — data is lost
# on restart). Set a real connection string for any persistent deployment.
MONGODB_URI=

# Authentication -----------------------------------------------------------
# Required in production. Minimum 32 characters.
AUTH_SECRET=
# Session lifetime (default: 7d)
AUTH_EXPIRES_IN=7d

# Session cookie SameSite. Leave as lax for a normal deployment.
# Set to none ONLY when the app is embedded in an iframe on another domain, which
# requires the site to be served over HTTPS. That mode also adds the Partitioned
# (CHIPS) attribute, without which browsers drop the cookie as a third-party one
# and sign-in appears to silently fail. See src/lib/auth/cookie.ts.
SESSION_COOKIE_SAME_SITE=lax

# First administrator ------------------------------------------------------
# The application ships with NO user accounts. If these two variables are set
# and the user collection is empty, one administrator is created on first
# startup. Leave them empty to create accounts from Admin → Users instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_OFFICIAL_ID=
BOOTSTRAP_ADMIN_DEPARTMENT=
# One of: SUPER_ADMIN, REGULATORY_ADMIN, ENFORCEMENT_OFFICER, REVIEWER, ANALYST, AUDITOR
BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN

# Evidence storage ---------------------------------------------------------
# local (default) writes to STORAGE_PATH. The StorageProvider interface allows
# an object-storage provider to be added without changing callers.
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Analysis provider --------------------------------------------------------
# development — runs the pipeline without a vision model (default).
#             Findings are routed to human review; nothing is fabricated.
# http        — calls the real vision model at AI_SERVICE_URL.
AI_PROVIDER=development
AI_SERVICE_URL=
AI_SERVICE_KEY=
AI_MODEL_VERSION=

# Rule engine --------------------------------------------------------------
DEFAULT_RULESET_VERSION=LM-PC-2011
# Confidence at or above this is treated as a confident automated decision.
CONFIDENCE_THRESHOLD_HIGH=90
# Below this, a finding is routed to human review.
CONFIDENCE_THRESHOLD_MEDIUM=75

# E-commerce listing source ------------------------------------------------
# Optional. Leave unset and the module reports "no provider configured"
# instead of returning listing data.
ECOMMERCE_PROVIDER=
ECOMMERCE_API_URL=
ECOMMERCE_API_KEY=

# Build --------------------------------------------------------------------
# Optional. Next.js writes its build to .next by default. Set this to keep two
# servers from clobbering each other's chunks — `next dev` and `next start`
# cannot share one directory. The npm scripts set it themselves; you only need
# this if you run next directly. See README §12.
NEXT_DIST_DIR=
