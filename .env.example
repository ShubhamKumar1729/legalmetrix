# Database
MONGODB_URI=mongodb://localhost:27017/sih-compliance
# For demo without MongoDB, app will fallback to in-memory store

# Auth
AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
AUTH_EXPIRES_IN=7d

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=sih-compliance-evidence
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI Service (Mock by default)
AI_PROVIDER=mock
AI_SERVICE_URL=
AI_SERVICE_KEY=
AI_MODEL_VERSION=mock-vision-v0.1.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Rule Engine
DEFAULT_RULESET_VERSION=LM-PC-2011-v1.2
CONFIDENCE_THRESHOLD_HIGH=90
CONFIDENCE_THRESHOLD_MEDIUM=75


officer@gov.in / Gov@2026
reviewer@gov.in / Gov@2026
admin@gov.in / Gov@2026
analyst@gov.in / Gov@2026