# ──────────────────────────────────────────────────────────────
# LegalMetrix configuration — copy to .env and edit
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Database
# If unreachable, the app automatically falls back to an in-memory demo store.
MONGODB_URI=mongodb://localhost:27017/sih-compliance

# Auth
# CHANGE THIS in production — any random string of 32+ characters.
AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
AUTH_EXPIRES_IN=7d

# Storage (evidence images)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# S3-compatible settings for production storage:
STORAGE_ENDPOINT=
STORAGE_BUCKET=sih-compliance-evidence
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── AI model (see MODEL_INTEGRATION.md) ──────────────────────
# 'mock' = built-in deterministic demo model (default)
# 'real' = your HTTP model service — set the URL + key below, no code changes
AI_PROVIDER=mock
AI_SERVICE_URL=
AI_SERVICE_KEY=
AI_MODEL_NAME=LegalMetrology Vision
AI_MODEL_VERSION=mock-vision-v0.1.0
AI_TIMEOUT_MS=60000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = mock fallbacks + deterministic demo data. Set to false for production.
NEXT_PUBLIC_DEMO_MODE=true

# Rule engine defaults (also editable in Settings without restart)
DEFAULT_RULESET_VERSION=LM-PC-2011-v1.2
CONFIDENCE_THRESHOLD_HIGH=90
CONFIDENCE_THRESHOLD_MEDIUM=75

# ── Demo accounts (seeded automatically; password Gov@2026) ──
#   admin@gov.in     Super Administrator
#   officer@gov.in   Enforcement Officer
#   reviewer@gov.in  Reviewer
#   analyst@gov.in   Analyst
